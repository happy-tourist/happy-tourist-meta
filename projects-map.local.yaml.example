# Локальные оверрайды путей к sibling-репозиториям.
# Скопируйте в projects-map.local.yaml и подправьте под свой workspace.
# Файл projects-map.local.yaml в git не коммитится.
#
# Пути: относительно корня happy-tourist-meta ИЛИ абсолютные.
# Ключи = таблица «Пути для OpenSpec / агентов» в docs/projects-map.md.
# Local перекрывает канон по ключу.

# --- Корни runtime ---
client: ../happy-tourist.github.io
server: ../happy-tourist-server

# --- Client (опционально; переопределять только если layout нестандартный) ---
# client.agents: ../happy-tourist.github.io/AGENTS.md
# client.src: ../happy-tourist.github.io/src/
# client.pages: ../happy-tourist.github.io/src/pages/
# client.stores: ../happy-tourist.github.io/src/stores/
# client.lib: ../happy-tourist.github.io/src/lib/
# client.assets: ../happy-tourist.github.io/src/assets/
# client.boot: ../happy-tourist.github.io/src/boot/
# client.tests: ../happy-tourist.github.io/test/

# --- Server (опционально) ---
# server.agents: ../happy-tourist-server/AGENTS.md
# server.src: ../happy-tourist-server/src/
# server.config: ../happy-tourist-server/src/config/
# server.lib: ../happy-tourist-server/src/lib/
# server.rooms: ../happy-tourist-server/src/rooms/
# server.schema: ../happy-tourist-server/src/rooms/schema/
# server.game: ../happy-tourist-server/src/game/
# server.db: ../happy-tourist-server/src/db/
# server.tests: ../happy-tourist-server/test/
# server.loadtest: ../happy-tourist-server/loadtest/

# Пример абсолютного пути (Windows):
# server: C:/Users/You/work/happy-tourist-server
